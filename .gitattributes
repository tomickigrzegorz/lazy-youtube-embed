# Normalize line endings: store LF in the repo, check out native on the working tree.
* text=auto eol=lf

# Force CRLF for Windows-only script files.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary files - never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
