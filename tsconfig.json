{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["DOM", "ES2017"],
    "module": "ESNext",
    "strict": true,
    "importHelpers": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "removeComments": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["sources/**/*"],
  "exclude": ["node_modules"]
}